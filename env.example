# 后端API地址配置
# 开发环境默认使用本地后端服务
VITE_API_BASE_URL=http://localhost:8888

# 生产环境示例
# VITE_API_BASE_URL=https://your-pansou-api.com

# 认证配置（可选，默认不启用）
# AUTH_ENABLED=false
# AUTH_USERS=admin:admin123,user:pass456
# AUTH_TOKEN_EXPIRY=24
# AUTH_JWT_SECRET=your-secret-key-here

# TMDB v4 Bearer Token（海报墙功能需要，用于 /tmdb-api 代理）
# 本地开发也可以写 VITE_TMDB_BEARER_TOKEN，vite.config.js 会读取，但推荐直接使用 TMDB_BEARER_TOKEN
TMDB_BEARER_TOKEN=
# VITE_TMDB_BEARER_TOKEN=

# TMDB 上游配置：默认使用 api.themoviedb.org。
# 如果 DNS 解析到不可达 IP，可指定一个已验证可用的 IP；start.sh 会自动探测并写入容器 /etc/hosts。
TMDB_API_HOST=api.themoviedb.org
TMDB_HOST_IP=65.9.175.66

# 代理配置：用于 PanSou 后端、电报频道、部分插件出网。
# 飞牛 NAS / Docker 容器常用 host.docker.internal:代理端口。
PROXY=http://host.docker.internal:20171
HTTP_PROXY=http://host.docker.internal:20171
HTTPS_PROXY=http://host.docker.internal:20171
ALL_PROXY=http://host.docker.internal:20171
NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal
