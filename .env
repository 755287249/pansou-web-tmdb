# 后端API地址配置
# 开发环境默认使用本地后端服务
VITE_API_BASE_URL=http://localhost:8888

# 生产环境示例
# VITE_API_BASE_URL=https://your-pansou-api.com

# 认证配置（可选，默认不启用）
# AUTH_ENABLED=false
# AUTH_USERS=admin:admin123,user:pass456
# AUTH_TOKEN_EXPIRY=24
# AUTH_JWT_SECRET=your-secret-key-here

# TMDB v4 Bearer Token（海报墙功能需要，用于 /tmdb-api 代理）
# 本地开发也可以写 VITE_TMDB_BEARER_TOKEN，vite.config.js 会读取，但推荐直接使用 TMDB_BEARER_TOKEN
TMDB_BEARER_TOKEN=
# VITE_TMDB_BEARER_TOKEN=
